{
  "name": "sorai-uptime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Public status page and uptime monitor on Cloudflare Workers (Astro + D1 + Cron).",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "db:create": "wrangler d1 create pulse",
    "db:local": "wrangler d1 execute pulse --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute pulse --remote --file=./schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.6",
    "@rolldown/binding-linux-x64-gnu": "^1.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.128.0"
  }
}
