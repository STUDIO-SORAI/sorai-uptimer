# Discord Webhook URL for outage & recovery alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# (Optional) Upstash Redis / Vercel KV for persistent 90-day history across serverless executions
# If not provided, in-memory cache and live probes are used seamlessly.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or Upstash format:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (Optional) CRON Secret to secure /api/ping against unauthorized triggers
CRON_SECRET=
