---
import '../styles/global.css';
import Header from '../components/Header.astro';
import MetricStats from '../components/MetricStats.astro';
import MonitorCard from '../components/MonitorCard.astro';
import PastIncidents from '../components/PastIncidents.astro';
import Footer from '../components/Footer.astro';
import { getDb } from '../lib/db';
import { buildSiteStatuses } from '../lib/status';

export const prerender = false;

let siteStatuses = [];
let error = '';
try {
  siteStatuses = await buildSiteStatuses(getDb());
} catch (err) {
  error = err instanceof Error ? err.message : String(err);
}

const downCount = siteStatuses.filter((s) => s.current.status === 'down').length;
const degradedCount = siteStatuses.filter((s) => s.current.status === 'degraded').length;
const operationalCount = siteStatuses.filter((s) => s.current.status === 'operational').length;

let overallStatus: 'operational' | 'degraded' | 'down' = 'operational';
if (downCount > 0) overallStatus = 'down';
else if (degradedCount > 0) overallStatus = 'degraded';

const updatedAt = new Date().toLocaleTimeString('en-US', {
  hour12: false,
  hour: '2-digit',
  minute: '2-digit',
  second: '2-digit',
  timeZone: 'Asia/Taipei',
});

const groups = Array.from(new Set(siteStatuses.map((s) => s.site.group || 'Main Services')));
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>System Status | Uptime Monitor</title>
    <meta name="description" content="Real-time uptime status for Bax and STUDIO SORAI." />
  </head>
  <body class="bg-black text-white min-h-screen overflow-x-hidden selection:bg-neutral-800">
    <div class="relative min-h-screen flex flex-col justify-between overflow-x-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl h-64 bg-radial from-blue-900/10 via-transparent to-transparent pointer-events-none -z-10"></div>

      <div class="w-full">
        <Header updatedAt={updatedAt} status={overallStatus} />

        <main class="w-full">
          {error && (
            <p class="max-w-4xl mx-auto px-4 mb-4 text-sm text-red-400">{error}</p>
          )}
          <MetricStats sites={siteStatuses} />

          <section class="w-full max-w-4xl mx-auto px-4">
            <div class="bg-[#0a0a0a] border border-[#1f1f1f] rounded-lg p-3 sm:p-6 shadow-2xl min-w-0">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between pb-4 border-b border-[#1f1f1f] mb-4">
                <h2 class="text-xs font-semibold uppercase tracking-wider text-neutral-300">
                  Services <span class="text-neutral-500 font-normal normal-case tracking-normal">({groups.length} groups • {siteStatuses.length})</span>
                </h2>
                <div class="flex items-center gap-2 text-[11px] sm:text-xs text-neutral-500 font-mono">
                  <span class="inline-block w-2 h-2 rounded-full bg-[#0070f3] animate-pulse"></span>
                  <span id="next-refresh-timer">Auto-refresh in 60s</span>
                </div>
              </div>

              <div id="monitors-container" class="space-y-6">
                {groups.map((groupName) => {
                  const groupSites = siteStatuses.filter((s) => (s.site.group || 'Main Services') === groupName);
                  return (
                    <div class="bg-[#0e0e0e] border border-[#1a1a1a] rounded-lg p-3 sm:p-4 min-w-0 overflow-hidden">
                      <div class="text-[11px] font-semibold uppercase tracking-wider text-neutral-400 mb-2 px-1 flex items-center justify-between border-b border-[#1f1f1f] pb-2">
                        <span class="flex items-center gap-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3]"></span>
                          {groupName}
                        </span>
                        <span class="text-neutral-500 font-mono text-[10px]">{groupSites.length} Active</span>
                      </div>
                      <div>
                        {groupSites.map((data) => (
                          <MonitorCard data={data} />
                        ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </section>

          <PastIncidents sites={siteStatuses} />
        </main>
      </div>

      <Footer />
    </div>

    <script>
      let secondsLeft = 60;
      const timerElement = document.getElementById('next-refresh-timer');
      const refreshBtn = document.getElementById('refresh-btn');
      const refreshIcon = document.getElementById('refresh-icon');
      const refreshText = document.getElementById('refresh-text');

      setInterval(() => {
        secondsLeft--;
        if (timerElement) {
          timerElement.innerText = `Auto-refresh in ${secondsLeft}s`;
        }
        if (secondsLeft <= 0) {
          triggerRefresh();
        }
      }, 1000);

      async function triggerRefresh() {
        secondsLeft = 60;
        if (refreshIcon) refreshIcon.classList.add('animate-spin');
        if (refreshText) refreshText.innerText = 'Pinging...';
        try {
          await fetch('/api/ping');
          window.location.reload();
        } catch (e) {
          console.error('Refresh failed:', e);
        } finally {
          if (refreshIcon) refreshIcon.classList.remove('animate-spin');
          if (refreshText) refreshText.innerText = 'Ping Now';
        }
      }

      refreshBtn?.addEventListener('click', () => {
        triggerRefresh();
      });
    </script>
  </body>
</html>
