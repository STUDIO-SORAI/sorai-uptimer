---
interface Props {
  updatedAt: string;
}

const { updatedAt } = Astro.props;
---

<header class="w-full max-w-4xl mx-auto pt-8 pb-6 px-4 flex items-center justify-between">
  <div class="flex items-center gap-3">
    <!-- Vercel Triangle Logo -->
    <a href="/" class="group flex items-center gap-3 transition-opacity hover:opacity-80">
      <svg
        class="w-6 h-6 text-white fill-current transition-transform duration-300 group-hover:scale-105"
        viewBox="0 0 1155 1000"
      >
        <path d="M577.347 0L1154.69 1000H0L577.347 0Z" />
      </svg>
      <div class="flex items-center gap-2">
        <span class="text-sm font-semibold tracking-tight text-white">Status</span>
        <span class="text-[10px] font-mono uppercase bg-neutral-900 text-neutral-400 px-1.5 py-0.5 rounded border border-neutral-800">Live</span>
      </div>
    </a>
  </div>

  <div class="flex items-center gap-3">
    <!-- Manual refresh trigger -->
    <button
      id="refresh-btn"
      class="text-xs font-medium bg-[#111] hover:bg-[#1a1a1a] text-neutral-300 hover:text-white px-3 py-1.5 rounded-md border border-[#262626] transition-all flex items-center gap-1.5 shadow-sm active:scale-95 cursor-pointer"
      title="Check live status now"
    >
      <svg id="refresh-icon" class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
      </svg>
      <span id="refresh-text">Ping Now</span>
    </button>

    <!-- Test Discord Webhook Button -->
    <button
      id="open-webhook-modal"
      class="text-xs font-medium bg-white hover:bg-neutral-200 text-black px-3.5 py-1.5 rounded-md transition-all shadow-sm active:scale-95 cursor-pointer font-sans"
    >
      Discord Webhook
    </button>
  </div>
</header>
