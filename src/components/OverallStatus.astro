---
import type { ServiceStatus } from '../lib/types';

interface Props {
  status: ServiceStatus;
  operationalCount: number;
  totalCount: number;
}

const { status, operationalCount, totalCount } = Astro.props;

const isAllOperational = status === 'operational';
const isDegraded = status === 'degraded';
const isDown = status === 'down';

const bgClass = isAllOperational
  ? 'bg-[#0070f3] text-white'
  : isDegraded
  ? 'bg-[#f5a623] text-black'
  : 'bg-[#ef4444] text-white';

const title = isAllOperational
  ? 'All Systems Operational'
  : isDegraded
  ? 'Degraded System Performance'
  : 'Service Outage Detected';
---

<section class="w-full max-w-4xl mx-auto px-4 mb-8">
  <div
    id="overall-banner"
    class={`w-full rounded-md px-5 py-4 flex items-center justify-between transition-all duration-300 shadow-lg ${bgClass}`}
  >
    <div class="flex items-center gap-3">
      {isAllOperational && (
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      )}
      {isDegraded && (
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      )}
      {isDown && (
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      )}
      <div>
        <h1 class="text-base font-semibold tracking-tight">{title}</h1>
      </div>
    </div>

    <div class="text-right text-xs opacity-90 font-medium">
      <span>{operationalCount}/{totalCount} Operational</span>
      <span class="mx-1.5 opacity-60">•</span>
      <span>1m interval</span>
    </div>
  </div>
</section>
