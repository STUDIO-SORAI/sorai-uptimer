---
import type { SiteStatusData } from '../lib/types';

interface Props {
  data: SiteStatusData;
}

const { data } = Astro.props;
const { site, current, history, uptime90d } = data;
const host = new URL(site.url).hostname;

const isOperational = current.status === 'operational';
const isDegraded = current.status === 'degraded';
const isDown = current.status === 'down';

const statusLabel = isOperational ? 'Operational' : isDegraded ? 'Degraded' : 'Down';
const statusColor = isOperational
  ? 'text-[#0070f3]'
  : isDegraded
    ? 'text-[#f5a623]'
    : 'text-[#ef4444]';
---

<div class="py-5 sm:py-6 border-b border-[#1c1c1c] last:border-b-0 min-w-0">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between mb-3 min-w-0">
    <div class="flex items-start gap-2 min-w-0">
      <span class="text-neutral-500 font-mono text-xs select-none mt-0.5">›</span>
      <div class="min-w-0">
        <a
          href={site.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-semibold text-white hover:text-[#0070f3] transition-colors inline-flex items-center gap-1.5 max-w-full"
        >
          <span class="truncate">{site.name}</span>
        </a>
        <div class="text-[11px] text-neutral-500 font-mono truncate">{host}</div>
      </div>
    </div>

    <div class="flex items-center gap-3 pl-4 sm:pl-0 shrink-0">
      <span class="text-xs font-mono text-neutral-400">
        {current.responseTime > 0 ? `${current.responseTime}ms` : 'Timeout'}
      </span>
      <div class="flex items-center gap-1.5">
        <span class={`w-1.5 h-1.5 rounded-full ${isOperational ? 'bg-[#0070f3]' : isDegraded ? 'bg-[#f5a623]' : 'bg-[#ef4444]'}`}></span>
        <span class={`text-xs font-medium ${statusColor}`}>{statusLabel}</span>
      </div>
    </div>
  </div>

  <div class="relative my-2 min-w-0 overflow-hidden">
    <div class="flex items-stretch gap-px sm:gap-[2px] h-6 sm:h-7 w-full min-w-0">
      {history.map((day) => {
        const barColor =
          day.status === 'operational'
            ? 'bg-[#0070f3]'
            : day.status === 'degraded'
              ? 'bg-[#f5a623]'
              : day.status === 'nodata'
                ? 'bg-[#1f1f1f]'
                : 'bg-[#ef4444]';

        return (
          <div class={`flex-1 min-w-0 rounded-[1px] ${barColor} relative group/bar`}>
            <div class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden sm:group-hover/bar:flex flex-col items-center z-50 whitespace-nowrap">
              <div class="bg-[#171717] border border-[#2e2e2e] text-white text-[11px] px-2.5 py-1.5 rounded shadow-xl text-center">
                <div class="font-medium text-neutral-200">{day.date}</div>
                <div class="text-[10px] text-neutral-400 mt-0.5">
                  <span class={day.status === 'operational' ? 'text-[#0070f3]' : day.status === 'degraded' ? 'text-[#f5a623]' : day.status === 'nodata' ? 'text-neutral-500' : 'text-[#ef4444]'}>
                    {day.status.toUpperCase()}
                  </span>
                  {' • '}{day.uptimePercent}% uptime
                  {day.avgLatency > 0 && ` • ${day.avgLatency}ms`}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <div class="flex items-center justify-between text-[10px] sm:text-[11px] text-neutral-500 font-medium mt-1.5 gap-2">
    <span class="shrink-0">90d</span>
    <span class="text-neutral-400 font-mono truncate">{uptime90d}% uptime</span>
    <span class="shrink-0">Today</span>
  </div>
</div>
