---
import type { SiteStatusData } from '../lib/types';

interface Props {
  data: SiteStatusData;
}

const { data } = Astro.props;
const { site, current, history, uptime90d, avgLatency } = data;

const isOperational = current.status === 'operational';
const isDegraded = current.status === 'degraded';
const isDown = current.status === 'down';

const statusLabel = isOperational
  ? 'Operational'
  : isDegraded
  ? 'Degraded'
  : 'Down';

const statusColor = isOperational
  ? 'text-[#0070f3]'
  : isDegraded
  ? 'text-[#f5a623]'
  : 'text-[#ef4444]';
---

<div class="py-6 border-b border-[#1c1c1c] last:border-b-0">
  <!-- Title & Current Status -->
  <div class="flex items-center justify-between mb-3.5">
    <div class="flex items-center gap-2">
      <span class="text-neutral-500 font-mono text-xs select-none">›</span>
      <a
        href={site.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-white hover:text-[#0070f3] transition-colors flex items-center gap-1.5 group"
      >
        <span>{site.name}</span>
        <svg class="w-3 h-3 text-neutral-600 group-hover:text-[#0070f3] opacity-0 group-hover:opacity-100 transition-all -translate-x-0.5 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
      <span class="text-xs text-neutral-500 font-mono">({new URL(site.url).hostname})</span>
      {site.group && (
        <span class="hidden sm:inline-block text-[10px] uppercase font-mono text-neutral-500 bg-neutral-900 border border-neutral-800 px-1.5 py-0.5 rounded ml-1">
          {site.group}
        </span>
      )}
    </div>

    <div class="flex items-center gap-3">
      <span class="text-xs font-mono text-neutral-400">
        {current.responseTime > 0 ? `${current.responseTime}ms` : 'Timeout'}
      </span>
      <div class="flex items-center gap-1.5">
        <span class={`w-1.5 h-1.5 rounded-full ${isOperational ? 'bg-[#0070f3]' : isDegraded ? 'bg-[#f5a623]' : 'bg-[#ef4444]'}`}></span>
        <span class={`text-xs font-medium ${statusColor}`}>
          {statusLabel}
        </span>
      </div>
    </div>
  </div>

  <!-- 90 Days Timeline Bar Graph -->
  <div class="relative group/timeline my-2">
    <div class="flex items-stretch justify-between gap-[2px] sm:gap-[3px] h-7 w-full overflow-hidden">
      {history.map((day, idx) => {
        const barColor =
          day.status === 'operational'
            ? 'bg-[#0070f3] hover:bg-[#38bdf8]'
            : day.status === 'degraded'
            ? 'bg-[#f5a623] hover:bg-[#fbbf24]'
            : 'bg-[#ef4444] hover:bg-[#f87171]';

        return (
          <div
            class={`flex-1 rounded-[1px] cursor-pointer transition-all duration-150 relative group/bar ${barColor}`}
            data-date={day.date}
            data-status={day.status}
            data-latency={day.avgLatency}
            data-uptime={day.uptimePercent}
          >
            <!-- Floating Tooltip -->
            <div class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/bar:flex flex-col items-center z-50 whitespace-nowrap">
              <div class="bg-[#171717] border border-[#2e2e2e] text-white text-[11px] px-2.5 py-1.5 rounded shadow-xl font-sans text-center">
                <div class="font-medium text-neutral-200">{day.date}</div>
                <div class="text-[10px] text-neutral-400 mt-0.5">
                  <span class={day.status === 'operational' ? 'text-[#0070f3]' : day.status === 'degraded' ? 'text-[#f5a623]' : 'text-[#ef4444]'}>
                    {day.status.toUpperCase()}
                  </span>
                  {' • '}{day.uptimePercent}% uptime
                  {day.avgLatency > 0 && ` • ${day.avgLatency}ms`}
                </div>
              </div>
              <div class="w-1.5 h-1.5 bg-[#171717] border-r border-b border-[#2e2e2e] rotate-45 -mt-1"></div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Legend & Uptime Stats -->
  <div class="flex items-center justify-between text-[11px] text-neutral-500 font-medium mt-1.5">
    <span>90 days ago</span>
    <span class="text-neutral-400 font-mono">{uptime90d}% uptime</span>
    <span>Today</span>
  </div>
</div>
