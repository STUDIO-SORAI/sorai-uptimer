---
---

<div
  id="webhook-modal"
  class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200"
>
  <div class="bg-[#0e0e0e] border border-[#262626] rounded-xl max-w-md w-full p-6 shadow-2xl relative text-left">
    <button
      id="close-webhook-modal"
      class="absolute top-4 right-4 text-neutral-400 hover:text-white p-1 rounded-md transition-colors"
      aria-label="Close"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-lg bg-[#5865F2]/10 border border-[#5865F2]/30 flex items-center justify-center text-[#5865F2]">
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-white">Discord Webhook Alert</h3>
        <p class="text-xs text-neutral-400">Instant notification on site outage & recovery</p>
      </div>
    </div>

    <div class="space-y-4 text-xs text-neutral-300">
      <div>
        <label for="discord-url-input" class="block font-medium text-neutral-400 mb-1.5">
          Custom Webhook URL (Optional for testing)
        </label>
        <input
          type="url"
          id="discord-url-input"
          placeholder="https://discord.com/api/webhooks/..."
          class="w-full bg-[#141414] border border-[#2b2b2b] focus:border-[#0070f3] text-white px-3 py-2 rounded-md outline-none transition-colors font-mono text-[11px]"
        />
        <p class="text-[11px] text-neutral-500 mt-1">
          Or set <code class="text-neutral-400 bg-neutral-900 px-1 py-0.5 rounded">DISCORD_WEBHOOK_URL</code> in Vercel Environment Variables.
        </p>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <button
          id="send-test-alert-btn"
          class="flex-1 bg-[#5865F2] hover:bg-[#4752C4] text-white py-2 rounded-md font-medium transition-colors active:scale-98 cursor-pointer text-center"
        >
          Send Test Discord Alert
        </button>
      </div>

      <div id="test-alert-status" class="hidden text-[11px] p-2.5 rounded-md border"></div>
    </div>
  </div>
</div>
